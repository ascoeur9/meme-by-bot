---
import { needsUnlock, maskTerm, unlockPayload, type Meme } from '../lib/meme';

interface Props {
  meme: Meme;
}

const { meme } = Astro.props;
const locked = needsUnlock(meme);
const statusLabel = meme.status === 'active' ? '활성' : '쇠퇴';
const payload = locked ? unlockPayload(meme) : null;
const displayTerm = locked ? maskTerm(meme.term) : meme.term;
---
<article
  class="card"
  data-meme-id={meme.id}
  data-needs-unlock={locked ? 'true' : 'false'}
  data-layout="list"
>
  <div class="card-top">
    <h2 class:list={['term', { masked: locked }]} data-field="term">{displayTerm}</h2>
    <div class="badges">
      {locked && <span class="badge hidden-badge">접힘</span>}
      <span class:list={['badge', `status-${meme.status}`]}>{statusLabel}</span>
    </div>
  </div>

  <div class="meta-row">
    <span>첫 등장 {meme.firstSeen}</span>
    <span>정점 {meme.peak}</span>
    <span>쇠퇴 {meme.fade}</span>
  </div>

  {locked && (
    <>
      <p class="fold-hint">평가·갈등 뉘앙스가 있을 수 있어요</p>
      <button type="button" class="reveal-btn" aria-label="주의하고 열어보기">주의하고 열어보기</button>
    </>
  )}

  {locked ? (
    <>
      {/* Empty until unlock — no plaintext body nodes in the locked DOM */}
      <div class="body-block" data-unlock-body hidden></div>
      <script
        type="application/json"
        data-unlock-payload
        is:inline
        set:html={JSON.stringify(payload)}
      />
    </>
  ) : (
    <div class="body-block">
      <p>{meme.meaning}</p>
      <p><strong>예:</strong> {meme.example}</p>
      <div class="tags">
        {meme.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    </div>
  )}

  <p class="meta-row" style="margin:0">
    <a href={`/memes/${meme.id}`}>자세히 보기 →</a>
  </p>
</article>
