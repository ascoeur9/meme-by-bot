---
interface Meme {
  id: string;
  term: string;
  meaning: string;
  example: string;
  firstSeen: string;
  peak: string;
  fade: string;
  sourceCount: number;
  tags: string[];
  status: 'active' | 'faded';
  sensitivity: 'safe' | 'sensitive';
  visibilityDefault: 'public' | 'hidden';
  updatedAt: string;
}

interface Props {
  meme: Meme;
}

const { meme } = Astro.props;
const needsUnlock =
  meme.visibilityDefault === 'hidden' || meme.sensitivity === 'sensitive';
const statusLabel = meme.status === 'active' ? '활성' : '쇠퇴';
---
<article
  class="card"
  data-meme-id={meme.id}
  data-needs-unlock={needsUnlock ? 'true' : 'false'}
>
  <div class="card-top">
    <h2 class:list={['term', { masked: needsUnlock }]}>{meme.term}</h2>
    <div class="badges">
      {needsUnlock && <span class="badge hidden-badge">가려짐</span>}
      <span class:list={['badge', `status-${meme.status}`]}>{statusLabel}</span>
      {meme.sensitivity === 'sensitive' && <span class="badge">민감</span>}
    </div>
  </div>

  <div class="meta-row">
    <span>첫 등장 {meme.firstSeen}</span>
    <span>정점 {meme.peak}</span>
    <span>쇠퇴 {meme.fade}</span>
  </div>

  {needsUnlock && (
    <button type="button" class="reveal-btn">내용 보기</button>
  )}

  <div class:list={['body-block', { 'masked-block': needsUnlock }]}>
    <p>{meme.meaning}</p>
    <p><strong>예:</strong> {meme.example}</p>
    <div class="tags">
      {meme.tags.map((t) => <span class="tag">{t}</span>)}
    </div>
  </div>

  <p class="meta-row" style="margin:0">
    <a href={`/memes/${meme.id}`}>자세히 보기 →</a>
  </p>
</article>
