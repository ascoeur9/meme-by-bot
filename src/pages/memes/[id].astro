---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MemeEntry from '../../components/MemeEntry.astro';
import memes from '../../../data/memes.json';
import { needsUnlock, type Meme } from '../../lib/meme';

export function getStaticPaths() {
  return (memes as Meme[]).map((meme) => ({
    params: { id: meme.id },
    props: { meme },
  }));
}

const { meme } = Astro.props as { meme: Meme };
const locked = needsUnlock(meme);
const pageTitle = locked ? '접혀 있음' : meme.term;
const pageDescription = locked
  ? '접힌 밈·슬랭 항목'
  : `${meme.term} 라이프사이클`;
---
<BaseLayout title={pageTitle} description={pageDescription}>
  <p class="back"><a href="/">목록으로</a></p>
  <MemeEntry meme={meme} layout="detail" />
</BaseLayout>
